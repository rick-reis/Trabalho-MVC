@model Produto


<h1>Apagar Produto</h1>

<form method="post">
    <label class="form-label mt-4" asp-for="Nome"></label>
    <input style="background-color: lightgray" class="form-control text-muted" asp-for="Nome" readonly />
    <p class="text-danger"><span asp-validation-for="Nome"></span></p>

    <label class="form-label mt-4" asp-for="Preco"></label>
    <input style="background-color: lightgray" class="form-control text-muted" asp-for="Preco" readonly />
    <p class="text-danger"><span asp-validation-for="Preco"></span></p>

    <div class="pt-3">
        <button class="btn btn-outline-danger" type="submit">Apagar</button>
        <a class="btn btn-outline-dark" asp-controller="Produtos" asp-action="Index">Voltar</a>
    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}