@model List<Produto>


@{
    ViewData["Title"] = "Lista de Produtos";
}

<h1>Lista de Produtos</h1>

<table class="table table-hover table-stripped">
    <tr>
        <th>Id</th>
        <th>Nome Produto</th>
        <th>Preço</th>
    </tr>


    @foreach (var dados in Model)
    {
        <tr>
            <td>@dados.Id</td>
            <td>@dados.Nome</td>
            <td>@dados.Preco</td>
        </tr>
    }
</table>
