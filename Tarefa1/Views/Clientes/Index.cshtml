@model List<Tarefa1.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="container p-3">
    <div><h1><i class="bi bi-card-heading"></i>  Lista de Clientes</h1></div>
    <div class="text-end">
    <a class="btn btn-success" asp-controller="Clientes" asp-action="AdicionarCliente"><i class="bi bi-patch-plus-fill"></i> Novo Cliente</a>
    </div>
</div>

<table class="table table-hover table-stripped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
			<th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.Id</td>
                <td>@cliente.Nome</td>
                <td>@cliente.Email</td>
                <td>@cliente.Telefone</td>
                <td> <a class="btn btn-warning" asp-controller="Clientes" asp-action="EditarCliente" asp-route-id="@cliente.Id"><i class="bi bi-pencil"></i>  Editar</a>
                     <a class="btn btn-danger" asp-controller="Clientes" asp-action="ApagarCliente" asp-route-id="@cliente.Id"><i class="bi bi-eraser"></i>  Apagar</a>
                     </td>
            </tr>
        }
    </tbody>
</table>
